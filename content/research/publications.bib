@inproceedings{MTMT:37372988,
  abstract = {In our experience as developers and software engineering researchers, static analysis tools often produce an overwhelming amount of warnings, many of which prove irrelevant within a specific project context. Despite their intent to improve code quality, these tools frequently generate diagnostic noise that erodes developer trust and leads to alert fatigue. Within this work, we explore how project-aware actionability detection can help bridge the gap between automated analysis and developers' practical needs. We present a preliminary study using an active learning-based framework to distinguish actionable coding rule violations from non-actionable ones. Experiments across 21 diverse projects from the NASCAR dataset show that a Random Forest-based active learner can achieve stable F1scores with only 20-40 \% of labeled data, significantly reducing manual annotation effort. While computational efficiency remains a limitation, our findings suggest that such models could be integrated into IDEs and project management environments, where lightweight developer feedback would enable continuous refinement of project-specific actionability models. © 2026 IEEE.},
  author = {Széles, Csoma Lázár and Balogh, Gergő},
  booktitle = {2026 IEEE International Conference on Software Analysis, Evolution and Reengineering - Companion (SANER-C)},
  doi = {10.1109/SANER-C67878.2026.00040},
  keywords = {Project management; Learning systems; artificial intelligence; machine learning; Software engineering; COMPUTER PROGRAMMING; Codes (symbols); Engineering education; Computational efficiency; Analysis tools; Machine-learning; Active learning; Active learning; False positive; False positive; Static code analysis; Static code analysis; Coding rule; code quality; actionability; Labeled data; actionable; actionable; rule violation; rule violation},
  mtmt-url = {https://m2.mtmt.hu/api/publication/37372988},
  orcid-numbers = {Balogh, Gergő/0000-0002-6781-5453},
  pages = {250--256},
  publisher = {IEEE},
  title = {{Towards Project-Aware Actionability Detection for Coding Rule Violations}},
  unique-id = {37372988},
  url = {https://doi.org/10.1109/SANER-C67878.2026.00040},
  year = {2026}
}

